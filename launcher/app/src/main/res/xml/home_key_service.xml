<?xml version="1.0" encoding="utf-8"?>
<!-- Watches which app comes to the front (window changes only, no screen content, no key filtering: filtering
     keys stopped held buttons repeating). Google TV's home and YouTube are handed over to this launcher and
     the theme's youtube_button_app, and Settings keeps the screensaver away. See HomeKeyService. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:description="@string/home_key_description" />
